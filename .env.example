# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/janvoice_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver
# HIBERNATE_DIALECT is no longer needed: Hibernate auto-detects the dialect
# from the JDBC connection (remove this env var from your .env if present).

# Security Configuration
SESSION_TOKEN_SECRET=your_32_character_minimum_secure_random_string_here

# AI Material Classification (Gemini Vision API)
# Never commit a real API key. Get one from https://aistudio.google.com/apikey
# Leave blank to disable AI classification (frontend falls back to manual selection).
GEMINI_API_KEY=
# Vision-capable Gemini model (free-tier friendly). Override only if needed.
GEMINI_CLASSIFICATION_MODEL=gemini-2.0-flash
GEMINI_MAX_IMAGE_BYTES=10485760

# ============================================================
# Railway Deployment — Backend Environment Variables
# Set these in the Railway dashboard (not in this file):
#
#   DB_URL              = jdbc:mysql://<HOST>:<PORT>/railway?useSSL=true&serverTimezone=UTC
#   DB_USERNAME         = <Railway MySQL username>
#   DB_PASSWORD         = <Railway MySQL password>
#   SESSION_TOKEN_SECRET = <generate: [System.Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 } | % { [byte]$_ }))>
#   GEMINI_API_KEY      = AIzaSy... (your real Google AI Studio key)
#   ALLOWED_ORIGIN      = https://<your-frontend-app>.up.railway.app
#   SPRING_PROFILES_ACTIVE = prod
#   PORT                = 8080 (Railway injects this automatically — do NOT override)
#
# Railway Build/Deploy:
#   Root directory: backend
#   Build command:  mvn clean package -DskipTests
#   Start command:  java -jar target/ai-0.0.1-SNAPSHOT.jar
#   Health check path: /health
# ============================================================
