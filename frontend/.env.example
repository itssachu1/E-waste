# Frontend environment configuration.
#
# Local development (`npm run dev`)
#   Leave the value below as-is. Vite proxies /api to the Spring Boot backend,
#   so the SPA and the API share an origin and CORS is not involved.
#   (Alternatively set VITE_API_BASE_URL=/api and let the dev proxy handle it.)
VITE_API_BASE_URL=http://localhost:8080/api

# Deployed builds (Vercel / Railway / Netlify) — REQUIRED
#   Vite inlines this value at BUILD time. If it is missing, the bundle falls
#   back to /api, which points at the static host instead of the backend, and
#   every API call fails (404 from the static host, or a CORS error). Set it in
#   the hosting dashboard to the public backend URL, including the /api suffix:
#     VITE_API_BASE_URL=https://<your-backend>.up.railway.app/api
#   The backend must allow that frontend origin via CORS_ALLOWED_ORIGIN (see the
#   repository root .env.example). Then rebuild/redeploy the frontend so the new
#   value is baked into the bundle.
